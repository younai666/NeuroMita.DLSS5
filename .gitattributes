# 行尾规范化
# 文档一律 LF（CI 会检查 Markdown 是否含 CRLF）
* text=auto eol=lf
*.md text eol=lf

# Windows 脚本与工程文件保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf

# 二进制
*.png binary
*.jpg binary
*.zip binary
*.dll binary
*.addon64 binary
*.exe binary
*.ico binary
